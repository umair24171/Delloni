  "terms_conditions_title": "Deeloni - Terms & Conditions",
  "privacy_policy_title": "Deeloni - Privacy Policy",
  "effective_date": "Effective Date: {date}",
  "eligibility_title": "1. Eligibility",
  "eligibility_content": "By using Deeloni, you confirm that you are legally allowed to use online platforms in your country.",
  "account_registration_title": "2. Account & Registration",
  "account_registration_content": "To post ads or interact with other users, you may be required to create an account. You agree to provide accurate information and keep your login details secure.",
  "user_posted_content_title": "3. User-Posted Content",
  "user_posted_content_content": "You are solely responsible for the content you post. This includes the accuracy, legality, and appropriateness of your listings. We reserve the right to remove any content that violates our rules or Syrian law.",
  "prohibited_listings_title": "4. Prohibited Listings",
  "prohibited_listings_content": "You may not post content or listings that promote illegal goods or services, violate Syrian laws, or include hate speech, harassment, or misleading information.",
  "fees_title": "5. Fees",
  "fees_content": "Some features or categories may require payment. Any fees will be clearly displayed and are non-refundable once the ad goes live.",
  "disclaimer_title": "6. Disclaimer",
  "disclaimer_content": "Deeloni is a listing platform. We do not take part in any transaction, nor do we verify users or the accuracy of listings. Use caution and common sense when interacting with others.",
  "limitation_liability_title": "7. Limitation of Liability",
  "limitation_liability_content": "We are not responsible for any loss or damage resulting from your use of Deeloni. You use the platform at your own risk.",
  "termination_title": "8. Termination",
  "termination_content": "We reserve the right to suspend or delete accounts that violate these terms or our content guidelines.",
  "changes_terms_title": "9. Changes to Terms",
  "changes_terms_content": "These Terms may be updated. Continued use of Deeloni after updates constitutes your acceptance of the changes.",
  "governing_law_title": "10. Governing Law",
  "governing_law_content": "These Terms are governed by the laws of the Syrian Arab Republic.",
  "information_collect_title": "1. Information We Collect",
  "information_collect_content": "We may collect your name, email address, phone number, location, IP address, browser/device info, and ad content.",
  "how_use_info_title": "2. How We Use It",
  "how_use_info_content": "To manage your account, display ads, communicate with you, and improve platform functionality.",
  "sharing_info_title": "3. Sharing Your Info",
  "sharing_info_content": "We do not sell your data. We may share it with legal authorities or service providers.",
  "cookies_title": "4. Cookies",
  "cookies_content": "We use cookies to enhance your experience, remember your preferences, and analyze usage data. You can manage or disable cookies at any time through your browser settings.",
  "data_security_title": "5. Data Security",
  "data_security_content": "We take reasonable technical and organizational measures to protect your data. However, no system is 100% secure. You use Deeloni at your own risk.",
  "your_rights_title": "6. Your Rights",
  "your_rights_content": "You may access, update, or delete your personal information. Contact us at contact@deeloni.com.",
  "children_title": "7. Children",
  "children_content": "Deeloni is not intended for children under the legal minimum age in your country. We do not knowingly collect personal data from minors.",
